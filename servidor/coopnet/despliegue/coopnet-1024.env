# Configuración del servidor coopnet de sm64coopdx-1024 (/etc/coopnet-1024.env).
# Después de cambiarla: sudo systemctl restart coopnet-1024

# puertos: TCP para la lista de partidas, UDP para el encuentro (este y el siguiente)
COOPNET_PUERTO=34197
COOPNET_ENCUENTRO=34198

# telemetría: el resumen del último minuto (JSON) y el histórico (CSV, al lado)
COOPNET_TELEMETRIA=/var/lib/coopnet/telemetria.json

# última versión publicada del fork, para el aviso de versión nueva del juego
# (COOPNET_FORK_BUILD tiene que ser mayor que SMNET_FORK_BUILD del juego para que avise)
#COOPNET_FORK_BUILD=2
#COOPNET_FORK_VERSION="1024 beta 2"
#COOPNET_FORK_URL="https://github.com/TU_USUARIO/sm64coopdx-1024/releases"
